{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:benefitlens:personalization-plan-v1",
  "title": "Proposed personalization evidence and preparation plan",
  "x-implementation-status": "proposed-not-connected-to-runtime",
  "type": "object",
  "properties": {
    "contract_version": {"const":"personalization-plan-v1"},
    "example_kind": {"enum":["synthetic","runtime_record"]},
    "subject_id": {"type":"string","minLength":1},
    "opportunity_id": {"type":"string","minLength":1},
    "program_id": {"type":"string","minLength":1},
    "round_id": {"type":["string","null"]},
    "as_of": {"type":"string","format":"date"},
    "evidence": {"type":"array","items":{"$ref":"#/$defs/evidence"}},
    "facts": {"type":"array","items":{"$ref":"#/$defs/fact"}},
    "requirements": {"type":"array","items":{"$ref":"#/$defs/requirement"}},
    "resources": {"type":"array","items":{"$ref":"#/$defs/resource"}},
    "assessments": {"type":"array","items":{"$ref":"#/$defs/assessment"}},
    "guidance_rules": {"type":"array","items":{"$ref":"#/$defs/guidance"}},
    "draft_slots": {"type":"array","items":{"$ref":"#/$defs/slot"}},
    "next_questions": {"type":"array","items":{"$ref":"#/$defs/question"}}
  },
  "required": ["contract_version","example_kind","subject_id","opportunity_id","program_id","round_id","as_of","evidence","facts","requirements","resources","assessments","guidance_rules","draft_slots","next_questions"],
  "additionalProperties": false,
  "$defs": {
    "evidence": {"type":"object","properties":{"evidence_id":{"type":"string","minLength":1},"owner_scope":{"enum":["applicant","opportunity","reference_case"]},"owner_id":{"type":"string","minLength":1},"source_kind":{"enum":["official_notice","official_form","user_document","user_statement","public_profile","publication","experience_text","author_reflection"]},"identity_status":{"enum":["unverified","confirmed","ambiguous","rejected"]},"url":{"type":["string","null"]},"locator":{"type":"string","minLength":1},"quote":{"type":"string","minLength":1},"snapshot_id":{"type":"string","minLength":1},"observed_at":{"type":"string","format":"date-time"},"content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"required":["evidence_id","owner_scope","owner_id","source_kind","identity_status","url","locator","quote","snapshot_id","observed_at","content_sha256"],"additionalProperties":false},
    "fact": {"type":"object","properties":{"fact_id":{"type":"string","minLength":1},"field":{"type":"string","minLength":1},"value":{},"derivation_type":{"enum":["source_extract","rule_derived","semantic_inference","user_confirmed"]},"review_status":{"enum":["candidate","accepted","conflicted","rejected","missing"]},"evidence_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"minItems":1},"derived_from_fact_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"derivation_rule":{"type":["string","null"]},"eligible_for_final_use":{"type":"boolean"},"at":{"type":["string","null"]},"as_of":{"type":"string","format":"date"}},"required":["fact_id","field","value","derivation_type","review_status","evidence_ids","derived_from_fact_ids","derivation_rule","eligible_for_final_use","at","as_of"],"additionalProperties":false,"allOf":[{"if":{"properties":{"derivation_type":{"const":"semantic_inference"}}},"then":{"properties":{"eligible_for_final_use":{"const":false}}}},{"if":{"properties":{"review_status":{"not":{"const":"accepted"}}}},"then":{"properties":{"eligible_for_final_use":{"const":false}}}},{"if":{"properties":{"derivation_type":{"const":"rule_derived"}}},"then":{"properties":{"derived_from_fact_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"minItems":1},"derivation_rule":{"type":"string","minLength":1}}}},{"if":{"properties":{"eligible_for_final_use":{"const":true}}},"then":{"properties":{"review_status":{"const":"accepted"},"value":{"not":{"enum":[null,""]}}}}}]},
    "requirement": {"type":"object","properties":{"criterion_id":{"type":"string","minLength":1},"kind":{"enum":["eligibility","selection_criterion","application_document","activity","writing_prompt"]},"field":{"type":["string","null"]},"op":{"enum":["eq","in","not_in","gte","lte","between","exists",null]},"value":{},"at":{"type":["string","null"]},"condition_path":{"type":"string","minLength":1},"evidence_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"minItems":1},"interpretation_status":{"enum":["candidate","reviewed","ambiguous"]}},"required":["criterion_id","kind","field","op","value","at","condition_path","evidence_ids","interpretation_status"],"additionalProperties":false},
    "resource": {"type":"object","properties":{"resource_id":{"type":"string","minLength":1},"requirement_id":{"type":"string","minLength":1},"artifact_kind":{"enum":["official_blank_form","official_guideline","user_issued_record","user_authored_material","reference_example"]},"resolution_status":{"enum":["found","not_found","access_restricted","not_provided","stale","needs_user_provided"]},"download_url":{"type":["string","null"]},"evidence_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"minItems":1},"next_action":{"type":"string","minLength":1}},"required":["resource_id","requirement_id","artifact_kind","resolution_status","download_url","evidence_ids","next_action"],"additionalProperties":false,"allOf":[{"if":{"properties":{"resolution_status":{"const":"found"},"artifact_kind":{"enum":["official_blank_form","official_guideline"]}}},"then":{"properties":{"download_url":{"type":"string","pattern":"^https?://"}}}}]},
    "assessment": {"type":"object","properties":{"assessment_id":{"type":"string","minLength":1},"criterion_id":{"type":"string","minLength":1},"axis":{"enum":["eligibility","practical_fit","readiness"]},"status":{"enum":["satisfied","not_satisfied","unknown","exception_review"]},"fact_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"evidence_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"minItems":1},"missing_fields":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"reason":{"type":"string","minLength":1}},"required":["assessment_id","criterion_id","axis","status","fact_ids","evidence_ids","missing_fields","reason"],"additionalProperties":false,"allOf":[{"if":{"properties":{"status":{"enum":["satisfied","not_satisfied"]}}},"then":{"properties":{"fact_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"minItems":1}}}}]},
    "guidance": {"type":"object","properties":{"guidance_id":{"type":"string","minLength":1},"case_id":{"type":["string","null"]},"outcome_status":{"enum":["selected","not_selected","unknown"]},"guidance_kind":{"enum":["structure","strengthen","avoid","question"]},"observation":{"type":"string","minLength":1},"observation_scope":{"enum":["complete_text","excerpt","review","interview","official_requirement"]},"scope_limit":{"type":"string","minLength":1},"suggested_action":{"type":"string","minLength":1},"evidence_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"minItems":1},"required_user_fields":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"transfer_scope":{"enum":["same_program","cross_program","general"]},"causal_success_claim":{"const":false},"basis":{"enum":["official_constraint","text_observation","author_reflection"]}},"required":["guidance_id","case_id","outcome_status","guidance_kind","observation","observation_scope","scope_limit","suggested_action","evidence_ids","required_user_fields","transfer_scope","causal_success_claim","basis"],"additionalProperties":false,"allOf":[{"if":{"properties":{"basis":{"enum":["text_observation","author_reflection"]}}},"then":{"properties":{"case_id":{"type":"string","minLength":1}}}},{"if":{"properties":{"basis":{"const":"official_constraint"}}},"then":{"properties":{"case_id":{"const":null},"observation_scope":{"const":"official_requirement"}}}}]},
    "slot": {"type":"object","properties":{"slot_id":{"type":"string","minLength":1},"prompt_id":{"type":"string","minLength":1},"guidance_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"minItems":1},"fact_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"missing_fields":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"draft_text":{"type":["string","null"]}},"required":["slot_id","prompt_id","guidance_ids","fact_ids","missing_fields","draft_text"],"additionalProperties":false},
    "question": {"type":"object","properties":{"field":{"type":"string","minLength":1},"why_requirement_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"minItems":1},"question":{"type":"string","minLength":1}},"required":["field","why_requirement_ids","question"],"additionalProperties":false}
  }
}
