    "templates": "pipeline/config/paragraph_writing_templates_v1.json",
    "rubric": "pipeline/config/writing_quality_rubric_v1.json",
    "principles": "pipeline/config/writing_principles_v1.json"
  },
  "quality_rules": [
    "일반 품질, 장르별 구성과 사용자 스타일 선호를 구분한다.",
    "9개 기준은 미보정 진단 기준이며 평가 없이 점수를 채우지 않는다.",
    "문단 계획의 계약 검증은 설득력이나 합격 가능성의 검증이 아니다."
  ],
  "independent_evaluation": {
    "status": "required_not_performed_by_this_planner",
    "human_raters": 2,
