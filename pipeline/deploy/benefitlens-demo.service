[Unit]
Description=BenefitLens read-only PostgreSQL demo
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/longnew/Desktop/course_work/26-2 학기/데이터엔지니어링/benefitlens
Environment="PYTHONPATH=/home/longnew/Desktop/course_work/26-2 학기/데이터엔지니어링/benefitlens/pipeline/src"
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m data_platform.pipeline_demo --port 5179
