{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "semantic-writing-intent-v1"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "reader_question": {
            "type": "string",
            "minLength": 1
          },
          "purpose_status": {
            "enum": [
              "explicit_guidance",
              "semantic_interpretation",
              "declared_non_selection",
              "unclear"
            ]
          },
          "answer_use": {
            "enum": [
              "selection",
              "experience_review",
              "data_collection",
              "unspecified"
            ]
          },
          "temporal_scope": {
            "enum": [
              "past",
              "future",
              "mixed",
              "none",
              "unknown"
            ]
          },
          "axes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "evidence_demands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "enum": [
                    "literal_request",
                    "official_guidance",
                    "interpretation"
                  ]
                }
              },
              "required": [
                "role",
                "description",
                "basis"
              ]
            }
          },
          "source_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "document_id",
                "quote"
              ]
            }
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "alternative_readings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "missing_context": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answer_strategy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "proposed",
                  "not_needed",
                  "deferred"
                ]
              },
              "experience_selection": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "logical_links": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "opening_function": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "closing_function": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scope_conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "status",
              "experience_selection",
              "logical_links",
              "opening_function",
              "closing_function",
              "scope_conditions"
            ]
          }
        },
        "required": [
          "task_id",
          "reader_question",
          "purpose_status",
          "answer_use",
          "temporal_scope",
          "axes",
          "evidence_demands",
          "source_evidence",
          "reasoning",
          "alternative_readings",
          "missing_context",
          "answer_strategy"
        ]
      }
    }
  },
  "required": [
    "version",
    "observations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound semantic intent observations, before semantic review"
}
