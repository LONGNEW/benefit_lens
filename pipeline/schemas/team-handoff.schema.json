{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:benefitlens:team-handoff-v1",
  "title": "Team handoff execution contract v1",
  "description": "Structural schema plus Python cross-record, permission declaration, literal and review gates. Absent inputs stay empty. SQL projection uses the existing ten-table delivery schema; metadata is a required sidecar, not new SQL tables. Current/open is not full personal eligibility. to_delivery_rows requires literal checks unless structural_only is explicitly selected for non-publishing inspection.",
  "type": "object",
  "required": ["programs","opportunity_rounds","source_documents","evidence","claims","experience_cases","case_documents","writing_patterns","pattern_evidence","contract_version","bundle_id","producer","created_at","metadata"],
  "properties": {
    "programs": {"type":"array","items":{"$ref":"#/$defs/programs"}},
    "opportunity_rounds": {"type":"array","items":{"$ref":"#/$defs/opportunity_rounds"}},
    "source_documents": {"type":"array","items":{"$ref":"#/$defs/source_documents"}},
    "evidence": {"type":"array","items":{"$ref":"#/$defs/evidence"}},
    "claims": {"type":"array","items":{"$ref":"#/$defs/claims"}},
    "experience_cases": {"type":"array","items":{"$ref":"#/$defs/experience_cases"}},
    "case_documents": {"type":"array","items":{"$ref":"#/$defs/case_documents"}},
    "writing_patterns": {"type":"array","items":{"$ref":"#/$defs/writing_patterns"}},
    "pattern_evidence": {"type":"array","items":{"$ref":"#/$defs/pattern_evidence"}},
    "contract_version": {"const":"team-handoff-v1"},
    "bundle_id": {"type":"string","minLength":1},
    "producer": {"type":"string","minLength":1},
    "created_at": {"type":"string","format":"date-time"},
    "metadata": {"type":"object","properties":{"subject_id":{"type":"string"},"family_memberships":{"type":"array","items":{"type":"object","required":["program_id","round_id","opportunity_family_id","rule_version","review_state"],"properties":{"program_id":{"type":"string","minLength":1},"round_id":{"type":"string","minLength":1},"opportunity_family_id":{"type":"string","minLength":1},"rule_version":{"type":"string","minLength":1},"review_state":{"type":"string","minLength":1}}}},"claim_dependencies":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string","minLength":1}},"description":"Only declared same-variant dependencies are gated; missing references and cycles fail."}}}
  },
  "additionalProperties": false,
  "$defs": {
    "programs": {"type":"object","required":["program_id","title","issuer","opportunity_type"],"properties":{"program_id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"issuer":{"type":"string","minLength":1},"opportunity_type":{"type":"string","minLength":1}},"additionalProperties":true},
    "opportunity_rounds": {"type":"object","required":["program_id","round_id","opportunity_id","notice_version","status","official_url","application_url","opens_on","closes_on","announces_on","checked_on"],"properties":{"program_id":{"type":"string","minLength":1},"round_id":{"type":"string","minLength":1},"opportunity_id":{"type":"string","minLength":1},"notice_version":{"type":"string","minLength":1},"status":{"type":"string","minLength":1},"official_url":{"type":"string","minLength":1},"application_url":{"type":["string","null"],"minLength":1},"opens_on":{"type":["string","null"],"minLength":1},"closes_on":{"type":["string","null"],"minLength":1},"announces_on":{"type":["string","null"],"minLength":1},"checked_on":{"type":"string","minLength":1}},"additionalProperties":true},
    "source_documents": {"type":"object","required":["document_id","title","url","kind","capture_mode","fetched_at","raw_sha256","text_sha256","raw_path","text_path"],"properties":{"document_id":{"type":"string","minLength":1,"description":"Immutable raw/text snapshot identity, not a logical URL identifier. Changed bytes/extraction require another snapshot ID."},"title":{"type":"string","minLength":1},"url":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"capture_mode":{"type":"string","minLength":1},"fetched_at":{"type":"string","minLength":1},"raw_sha256":{"type":["string","null"],"minLength":1,"pattern":"^[0-9a-f]{64}$"},"text_sha256":{"type":"string","minLength":1,"pattern":"^[0-9a-f]{64}$"},"raw_path":{"type":["string","null"],"minLength":1},"text_path":{"type":"string","minLength":1},"access_scope":{"enum":["public","user_private"]},"owner_subject_id":{"type":"string","minLength":1},"permission_basis":{"type":"string","minLength":1}},"additionalProperties":true},
    "evidence": {"type":"object","required":["evidence_id","document_id","program_id","round_id","source_role","locator","quote"],"properties":{"evidence_id":{"type":"string","minLength":1},"document_id":{"type":"string","minLength":1},"program_id":{"type":"string","minLength":1},"round_id":{"type":["string","null"],"minLength":1},"source_role":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1},"quote":{"type":"string","minLength":1}},"additionalProperties":true},
    "claims": {"type":"object","required":["claim_id","program_id","round_id","kind","field","at","value","evidence_ids"],"properties":{"claim_id":{"type":"string","minLength":1},"program_id":{"type":"string","minLength":1},"round_id":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"field":{"type":"string","minLength":1},"at":{"type":["string","null"],"minLength":1},"value":{},"evidence_ids":{"type":"array","items":{"type":"string","minLength":1}},"semantic_review":{"type":"object","additionalProperties":{"type":"string"},"description":"Missing review metadata remains held. accepted needs reviewer, decision_id, reason and basis. human/agent_semantic_review needs a real review_receipt_ref; machine/existing_rule_review needs rule_id/version and is limited to student_scope and the two period/status fields. A review receipt records a review, not source truth. All accepted records need a matching input_scope_fingerprint; Claim scope binds basis/rule_id/rule_version and declared dependency IDs; other review fields and derived output are excluded. Human review means an actual recorded human review; agent review must use agent_semantic_review. Pattern fingerprints are checked by writing_scope_fingerprint.","properties":{"input_scope_fingerprint":{"type":"string"}}}},"additionalProperties":true},
    "experience_cases": {"type":"object","required":["case_id","program_id","experience_round_id","experience_round_label","outcome_status","outcome_basis","outcome_evidence_id","notes"],"properties":{"case_id":{"type":"string","minLength":1},"program_id":{"type":"string","minLength":1},"experience_round_id":{"type":["string","null"],"minLength":1},"experience_round_label":{"type":["string","null"],"minLength":1},"outcome_status":{"type":"string","minLength":1},"outcome_basis":{"type":"string","minLength":1},"outcome_evidence_id":{"type":["string","null"],"minLength":1},"notes":{"type":"string","minLength":1}},"additionalProperties":true},
    "case_documents": {"type":"object","required":["case_id","document_id","program_id","document_role","finality","binding_evidence_id"],"properties":{"case_id":{"type":"string","minLength":1},"document_id":{"type":"string","minLength":1},"program_id":{"type":"string","minLength":1},"document_role":{"type":"string","minLength":1},"finality":{"type":"string","minLength":1},"binding_evidence_id":{"type":["string","null"],"minLength":1},"finality_evidence_id":{"type":["string","null"]}},"additionalProperties":true},
    "writing_patterns": {"type":"object","required":["pattern_id","program_id","target_round_id","target_claim_id","pattern_kind","body","scope_status","causal_success_claim"],"properties":{"pattern_id":{"type":"string","minLength":1},"program_id":{"type":"string","minLength":1},"target_round_id":{"type":"string","minLength":1},"target_claim_id":{"type":["string","null"],"minLength":1},"pattern_kind":{"type":"string","minLength":1},"body":{"type":"object"},"scope_status":{"type":"string","minLength":1},"causal_success_claim":{"const":false},"semantic_review":{"type":"object","additionalProperties":{"type":"string"},"description":"Missing review metadata remains held. accepted needs reviewer, decision_id, reason and basis. human/agent_semantic_review needs a real review_receipt_ref; machine/existing_rule_review needs rule_id/version and is limited to student_scope and the two period/status fields. A review receipt records a review, not source truth. All accepted records need a matching input_scope_fingerprint; Claim scope binds basis/rule_id/rule_version and declared dependency IDs; other review fields and derived output are excluded. Human review means an actual recorded human review; agent review must use agent_semantic_review. Pattern fingerprints are checked by writing_scope_fingerprint.","properties":{"input_scope_fingerprint":{"type":"string"}}}},"additionalProperties":true},
    "pattern_evidence": {"type":"object","required":["pattern_id","program_id","target_round_id","evidence_id","document_id","source_program_id","source_round_id","case_id","case_document_role","purpose"],"properties":{"pattern_id":{"type":"string","minLength":1},"program_id":{"type":"string","minLength":1},"target_round_id":{"type":"string","minLength":1},"evidence_id":{"type":"string","minLength":1},"document_id":{"type":"string","minLength":1},"source_program_id":{"type":"string","minLength":1},"source_round_id":{"type":["string","null"],"minLength":1},"case_id":{"type":["string","null"],"minLength":1},"case_document_role":{"type":["string","null"],"minLength":1},"purpose":{"type":"string","minLength":1}},"additionalProperties":true}
  }
}
