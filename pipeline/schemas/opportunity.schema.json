{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenefitLens stored opportunity v1",
  "type": "object",
  "required": ["opportunity_id", "program_id", "round_id", "title", "category", "recipient_type", "issuer", "eligibility", "benefits", "application", "additional_checks", "requirements", "source_refs", "extractor", "extraction_status", "resolution_status"],
  "properties": {
    "opportunity_id": {"type": "string", "minLength": 1},
    "program_id": {"type": "string", "minLength": 1},
    "round_id": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "category": {"enum": ["scholarship", "fellowship", "admission_funding", "other"]},
    "recipient_type": {"const": "individual"},
    "issuer": {"type": "object", "required": ["name", "type", "country"], "properties": {"name": {"type": "string", "minLength": 1}, "type": {"type": "string"}, "country": {"type": ["string", "null"]}}},
    "eligibility": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/condition"}]},
    "benefits": {"type": "array", "items": {"type": "object", "required": ["type", "evidence_ref"], "properties": {"type": {"type": "string"}, "amount": {"type": ["number", "null"], "minimum": 0}, "min_amount": {"type": ["number", "null"], "minimum": 0}, "max_amount": {"type": ["number", "null"], "minimum": 0}, "currency": {"type": ["string", "null"]}, "evidence_ref": {"type": "string"}}}},
    "application": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string", "pattern": "^https?://"}, "opens_on": {"type": ["string", "null"]}, "closes_on": {"type": ["string", "null"]}, "prompts": {"type": "array"}}},
    "additional_checks": {"type": "array", "items": {"type": "object", "required": ["check_id", "question", "answer_type", "evidence_ref"], "properties": {"check_id": {"type": "string"}, "question": {"type": "string"}, "answer_type": {"type": "string"}, "evidence_ref": {"type": "string"}}}},
    "requirements": {"type": "array", "items": {"type": "object", "required": ["description", "evidence_ref"], "properties": {"description": {"type": "string"}, "evidence_ref": {"type": "string"}}}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "url"], "properties": {"id": {"type": "string", "minLength": 1}, "url": {"type": "string", "pattern": "^https?://"}, "anchor": {"type": "string"}}}},
    "extractor": {"type": "string", "minLength": 1},
    "extraction_status": {"type": "string"},
    "resolution_status": {"type": "string"}
  },
  "$defs": {
    "condition": {
      "oneOf": [
        {"type": "object", "required": ["all"], "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}, "additionalProperties": false},
        {"type": "object", "required": ["any"], "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}, "additionalProperties": false},
        {"type": "object", "required": ["not"], "properties": {"not": {"$ref": "#/$defs/condition"}}, "additionalProperties": false},
        {"type": "object", "required": ["field", "op", "value", "evidence_ref"], "properties": {"field": {"type": "string"}, "op": {"enum": ["eq", "in", "not_in", "gte", "lte", "between"]}, "value": {}, "at": {"type": "string"}, "evidence_ref": {"type": "string"}, "scale": {"type": "number", "exclusiveMinimum": 0}, "degree_scope": {"type": "string"}, "period_scope": {"type": "string"}}, "additionalProperties": false}
      ]
    }
  }
}
